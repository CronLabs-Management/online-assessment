# Copy to the cPanel Python app's environment variables (or a local .env you load yourself).
# Never commit real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=test.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://test.example.com

# --- MySQL (cPanel) ---
DB_NAME=your_cpanel_db
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_HOST=localhost
DB_PORT=3306

# --- Evidence storage: keep outside public_html ---
PRIVATE_MEDIA_ROOT=/home/your_cpanel_user/assessment_private
SNAPSHOT_MAX_BYTES=307200
SNAPSHOT_RATE_LIMIT_PER_10_MIN=30
EVENT_RATE_LIMIT_PER_MIN=120

# --- Code execution ---
# judge0 = isolated sandbox service on a separate host (required for production).
# local  = development only; runs code on this machine without a real sandbox.
CODE_RUNNER=judge0
JUDGE0_URL=https://judge.example.test
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
CODE_CPU_TIME_LIMIT_S=2
CODE_MEMORY_LIMIT_KB=262144
CODE_OUTPUT_LIMIT_KB=64

# --- Browser-side face model (optional override) ---
# FACE_MODEL_URL=https://your-domain.example/static/models/face_landmarker.task

# --- Site address and email (required in production) ---
# SITE_URL is used to build links in emails. It must be the public address, with no trailing slash.
SITE_URL=https://test.example.com
# Use the mail account created in cPanel (Email Accounts). Port 587 with TLS is typical.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=no-reply@test.example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Assessments <no-reply@test.example.com>
