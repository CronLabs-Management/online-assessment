# --- Email (SMTP via cPanel Mail - port 465 SSL) ---
# NOTE: mail.scrambler.in is proxied by Cloudflare CDN, which blocks SMTP ports 25, 465, and 587.
# Using 'mail.kottur.co.in' connects directly to the cPanel mail server and delivers immediately.
# (Alternatively, toggle Cloudflare DNS for 'mail' from Proxied to 'DNS only' to use mail.scrambler.in).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.kottur.co.in
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@scrambler.in
EMAIL_HOST_PASSWORD=Scrambler_user@2026
EMAIL_FROM=noreply@scrambler.in
DEFAULT_FROM_EMAIL=Assessments <noreply@scrambler.in>

# --- Code Execution Runner ---
# Use "judge0" in production if Judge0 is running on a dedicated server;
# or leave empty / use "local" for dev testing.
CODE_RUNNER=
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
CODE_CPU_TIME_LIMIT_S=2
CODE_MEMORY_LIMIT_KB=262144
CODE_OUTPUT_LIMIT_KB=64
